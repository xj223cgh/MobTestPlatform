# ============================================================
# MobTestPlatform 后端环境变量示例
# 使用方式：复制本文件为 .env，填入实际值
#   cp .env.example .env      (Linux/Mac)
#   copy .env.example .env    (Windows)
# 注意：.env 包含密钥，已在 .gitignore 中排除，切勿提交
# ============================================================

# ---------- Flask 启动 ----------
FLASK_ENV=development
PORT=5000

# ---------- MySQL 数据库 ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的数据库密码
MYSQL_DATABASE=mobile_test_platform

# ---------- 安全密钥 ----------
# 用于会话签名、Cookie、密码重置 token；生产环境务必改为随机强密钥
SECRET_KEY=请替换为随机长字符串

# ---------- AI 大模型（SiliconFlow 硅基流动） ----------
# API 密钥（在 https://siliconflow.cn 注册获取）
AI_API_KEY=sk-your-api-key
# API 基础地址
AI_BASE_URL=https://api.siliconflow.cn/v1
# 模型名称
AI_MODEL=Qwen/Qwen2.5-7B-Instruct
# 回复发散度（0~2，建议 0.2~0.7）
AI_TEMPERATURE=0.3
# 单次回复基础输出上限（token 数），长文档时会自动上调
AI_MAX_TOKENS=4096

# ---------- 图片识别 Vision（可选，不配置则跳过图片识别） ----------
# Vision 模型，复用 AI_API_KEY
# AI_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# 单次任务最多识别图片数（0 或不配置 = 不限制）
# AI_VISION_MAX_IMAGES=20

# ---------- 知识库 RAG（可选，不配置 EMBEDDING_MODEL 则跳过） ----------
# Embedding 模型，复用 AI_API_KEY
# EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# ChromaDB 持久化目录（相对于 backend/）
# CHROMA_PERSIST_DIR=./app/config/knowledge/chroma_data
# 检索返回 Top-K 相关片段数
# KNOWLEDGE_TOP_K=5

# ---------- CORS 跨域 ----------
# 额外允许的 origin（逗号分隔）；代码会自动合并本机端口和内网网段
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------- Agent 设备桥接 ----------
# 平台外网/内网地址：远程用户运行 MobTestAgent.exe --base-url 时填写
# AGENT_PLATFORM_BASE_URL=http://192.168.1.100:5000
# Agent 安装包路径（不配则按 agent_exe_path.txt → agent/dist/MobTestAgent.exe 查找）
# AGENT_EXE_PATH=
# Agent 本地服务端口（平台检测本机 Agent 是否运行，须与 agent/main.py 一致）
# AGENT_LOCAL_PORT=8765

# ---------- 会话（可选，管理后台「安全设置」可覆盖） ----------
# 会话超时（分钟），默认 1440（24 小时）
# SESSION_TIMEOUT_MINUTES=1440

# ---------- 分页（可选，管理后台「系统设置」可覆盖默认每页条数） ----------
# DEFAULT_PAGE_SIZE=20
# MAX_PAGE_SIZE=100

# ---------- 日志（可选） ----------
# LOG_LEVEL=INFO
# LOG_FILE=logs/app.log

# ---------- 文件存储与上传（可选） ----------
# 存储根目录（不填则使用 backend/storage）
# STORAGE_PATH=
# 设备脚本单文件最大字节（默认 10 MB）
# MAX_SCRIPT_SIZE=10485760
# Logo 单文件最大字节（默认 2 MB）
# MAX_LOGO_SIZE=2097152

# ---------- 邮件 SMTP（QQ 邮箱：验证码、找回密码） ----------
# 发件邮箱
SMTP_USER=你的QQ邮箱@qq.com
# QQ 邮箱授权码（设置 → 账户 → POP3/IMAP 生成，非登录密码）
SMTP_PASSWORD=你的SMTP授权码
# 以下可选，不填使用默认值
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USE_SSL=true
# SMTP_FROM_NAME=移动测试平台
# 前端重置密码页地址（邮件中的链接）
# FRONTEND_RESET_PASSWORD_URL=http://localhost:8080/reset-password

# ---------- Redis（可选，当前未启用） ----------
# REDIS_URL=redis://localhost:6379/0
