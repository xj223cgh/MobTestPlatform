# Flask 启动
FLASK_ENV=development
PORT=5000

# 数据库（config 使用 MYSQL_* 拼接连接串）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
# MYSQL_DATABASE=mobile_test_platform
MYSQL_DATABASE=kingsoft_test_platform

# 安全：SECRET_KEY 用于会话签名、Cookie 与密码重置等 token，生产环境务必改为随机强密钥
SECRET_KEY=your-secret-key-here

# AI_API_KEY: 硅基流动AI大模型 API 密钥
AI_API_KEY=sk-zvavgydgfaieedmbaexzwzfbumeawfwoxkfwvcafbmpqqbko
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_MODEL=Qwen/Qwen2.5-7B-Instruct
# AI_TEMPERATURE: 控制大模型回复的“发散程度”，数值越高回复越有创造性（0~2，默认建议 0.2~0.7）
AI_TEMPERATURE=0.3
# AI_MAX_TOKENS: 控制大模型单次回复的最大长度上限（token 数），例如 40960 表示支持较长的内容
AI_MAX_TOKENS=40960

# CORS（逗号分隔，会与本机及内网合并）
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Agent 平台地址：供前端「本机 Agent」使用方式中展示，远程用户运行 MobTestAgent.exe 时 --base-url 的值，如 http://192.168.1.100:5000
AGENT_PLATFORM_BASE_URL=http://192.168.5.228:5000

# ---------- 会话与分页（可选，不填用默认值；管理后台「安全设置/系统设置」可覆盖部分项） ----------
# 会话超时（分钟），默认 1440（24 小时）；管理后台「安全设置」可覆盖
# SESSION_TIMEOUT_MINUTES=1440
# 分页：默认每页条数、单页最大条数；管理后台「系统设置」可覆盖默认每页条数
# DEFAULT_PAGE_SIZE=20
# MAX_PAGE_SIZE=100

# ---------- 日志（可选） ----------
# LOG_LEVEL=INFO
# LOG_FILE=logs/app.log

# ---------- 存储与上传（可选，不填用 backend 下默认路径与大小） ----------
# 存储根目录（脚本、Logo 等在此下子目录）
# STORAGE_PATH=
# 设备脚本单文件最大字节，默认 10MB
# MAX_SCRIPT_SIZE=10485760
# 系统 Logo 单文件最大字节，默认 2MB
# MAX_LOGO_SIZE=2097152

# Redis（可选，当前项目未使用）
# REDIS_URL=redis://localhost:6379/0

# ---------- 邮件配置（QQ 邮箱：登录验证码、找回密码、绑定/解绑邮箱） ----------
# 必填：发件邮箱与授权码（QQ 邮箱 设置→账户→POP3/IMAP 生成授权码，非登录密码）
SMTP_USER=1479607445@qq.com
SMTP_PASSWORD=dehspufdscgchedj

# 可选：不填则使用默认值
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USE_SSL=true
# SMTP_FROM_NAME=移动测试平台
# FRONTEND_RESET_PASSWORD_URL=http://localhost:8080/reset-password
