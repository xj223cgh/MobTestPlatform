# Python
__pycache__/
*.py[cod]
# 部分环境产生的临时 bytecode 后缀
*.py[cod].*
*.pyo
*.pyd
.Python
*.so
.env
.venv
venv/
ENV/

# Flask
flask_session/
instance/

# 日志
backend/logs/

# 设备脚本按日期存储的目录（运行时生成）
backend/storage/device_scripts/

# Agent 下载路径（各服务器用脚本单独配置，不提交）
backend/agent_exe_path.txt

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# npm 本地缓存（勿提交；若曾被 add 过需 git rm --cached）
.npm-cache/

# 前端依赖（全仓库任意路径）
node_modules/

# 前端 Vue/Vite 目录：构建产物、缓存与依赖勿提交（与 frontend/.gitignore 一致，此处写明便于 monorepo 维护）
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/.npm-cache/
frontend/.cache/
frontend/.temp/
frontend/coverage/
frontend/.nyc_output/
